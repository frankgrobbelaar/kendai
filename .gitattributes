# Store text files with LF and check them out as LF on every OS,
# regardless of each machine's core.autocrlf setting.
* text=auto eol=lf

# Windows scripts need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: no line-ending conversion, no textual diffs.
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary

# Books, comics and archives, as test files: their bytes are what a fingerprint reads.
*.pdf binary
*.epub binary
*.mobi binary
*.azw binary
*.azw3 binary
*.cbz binary
*.cbr binary
*.cb7 binary
*.cbt binary
*.zip binary
*.rar binary
*.7z binary
*.tar binary
*.traineddata binary
